# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: OpenAI provider key (Maestro default orchestrator)
OPENAI_API_KEY=""

# ANTHROPIC_API_KEY: Anthropic provider key
ANTHROPIC_API_KEY=""

# Configurable Model Identifiers
OPENAI_MAESTRO_MODEL="gpt-4o"
OPENAI_DEFAULT_MODEL="gpt-4o-mini"
GEMINI_RESEARCH_MODEL="gemini-3.8-flash"
GEMINI_DEFAULT_MODEL="gemini-3.8-flash"
ANTHROPIC_DEFAULT_MODEL="claude-3-5-sonnet-20241022"

# Max Revision Loops for Samuel <-> Samsonite
MAX_AGENT_REVISIONS=3

# Timeouts in milliseconds
MODEL_TIMEOUT_MS=30000
AGENT_TIMEOUT_MS=45000
ORCHESTRATION_TIMEOUT_MS=120000

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
